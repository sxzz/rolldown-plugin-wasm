{
  "name": "rolldown-plugin-wasm",
  "type": "module",
  "version": "0.3.2",
  "description": "Rolldown plugin for WASM.",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "https://github.com/sxzz/rolldown-plugin-wasm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxzz/rolldown-plugin-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/sxzz/rolldown-plugin-wasm/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./types": "./types.d.ts"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "types.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "build:examples": "bash ./examples/build.sh",
    "dev": "tsdown --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules vitest --typecheck",
    "typecheck": "tsc --noEmit",
    "format": "prettier --cache --write .",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "rolldown": "^1.0.0"
  },
  "devDependencies": {
    "@sxzz/eslint-config": "^8.9.2",
    "@sxzz/prettier-config": "^2.3.3",
    "@sxzz/test-utils": "^0.5.20",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0",
    "rolldown": "1.3.2",
    "test-pkg": "./examples/pkg",
    "tsdown": "^0.23.7",
    "tsdown-preset-sxzz": "^0.7.1",
    "typescript": "^6.0.3",
    "typescript-next": "npm:typescript@^7.0.2",
    "vitest": "^5.1.0",
    "wasm-pack": "^0.15.1"
  },
  "prettier": "@sxzz/prettier-config"
}
